---
// Screenshot gallery with full-size viewing in a native dialog. Author: A097MPRUS.
// Only screenshots marked "available" in screenshots.json are shown; images keep their aspect
// ratio and are served as responsive WebP with the original PNG for full size.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { screenshots, type Screenshot } from '../data/site';

interface Props {
  group?: string;
  files?: string[];
  columns?: 1 | 2;
}
const { group, files, columns = 2 } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', {
  eager: true,
});
const byName = new Map(
  Object.entries(images).map(([path, mod]) => [path.split('/').pop() ?? '', mod.default]),
);
const items: (Screenshot & { image: ImageMetadata })[] = screenshots.items
  .filter((s) => s.status === 'available')
  .filter((s) => (group ? s.group === group : true))
  .filter((s) => (files ? files.includes(s.file) : true))
  .flatMap((s) => {
    const image = byName.get(s.file);
    return image ? [{ ...s, image }] : [];
  });
---

{items.length > 0 && (
  <ul class:list={['gallery', `cols-${columns}`]} data-gallery>
    {items.map((item) => (
      <li class="shot">
        <figure>
          <button
            type="button"
            class="open"
            data-full={item.image.src}
            data-caption={item.caption}
            data-alt={item.alt}
            aria-label={`View full size: ${item.alt}`}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 820, 1240, Math.min(1640, item.image.width)]}
              sizes={
                columns === 1
                  ? '(max-width: 1180px) 100vw, 1100px'
                  : '(max-width: 860px) 100vw, 560px'
              }
              format="webp"
              quality={86}
              loading="lazy"
            />
          </button>
          <figcaption>
            {item.caption}
            <span class="edition mono">{item.edition}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
)}

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  .cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
  }
  figure {
    margin: 0;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #1e1e1e;
    cursor: zoom-in;
    transition: border-color var(--t-feedback) var(--ease);
  }
  .open:hover {
    border-color: var(--line-strong);
  }
  .open :global(img) {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 10px;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .edition {
    display: block;
    margin-top: 4px;
    font-size: var(--step--2);
    color: var(--faint);
  }
</style>

<script>
  import { openLightbox } from '../lib/lightbox';
  document
    .querySelectorAll<HTMLButtonElement>('[data-gallery] .open')
    .forEach((b) =>
      b.addEventListener('click', () =>
        openLightbox(
          b.dataset['full'] ?? '',
          b.dataset['alt'] ?? '',
          b.dataset['caption'] ?? '',
          b,
        ),
      ),
    );
</script>
