---
// Compact sticky header with primary navigation. Author: A097MPRUS.
import { Image } from 'astro:assets';
import icon from '../assets/icon-256.png';
import Icon from './Icon.astro';
import { github, nav, url } from '../data/site';

interface Props {
  current?: string | undefined;
}
const { current } = Astro.props;
---

<header class="site-header" data-header>
  <div class="wrap wrap-wide bar">
    <a class="brand" href={url()} aria-label="GPX Viewer, home">
      <Image src={icon} alt="" width={28} height={28} loading="eager" />
      <span>GPX Viewer</span>
    </a>
    <nav class="primary" aria-label="Main">
      <ul class="links">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      {github.project && (
        <a class="tool-link" href={github.project}>
          GitHub
        </a>
      )}
      <a class="btn btn-primary btn-compact" href={url('downloads/')}>
        Download
      </a>
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        data-effective="dark"
        aria-label="Appearance"
      >
        <span class="theme-sun">
          <Icon name="sun" size={18} />
        </span>
        <span class="theme-moon">
          <Icon name="moon" size={18} />
        </span>
      </button>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span class="open-icon">
          <Icon name="menu" />
        </span>
        <span class="close-icon">
          <Icon name="close" />
        </span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
  <div id="site-menu" class="sheet" data-menu hidden>
    <nav aria-label="Main, small screens">
      <ul>
        <li>
          <a href={url()} aria-current={current === '' ? 'page' : undefined}>
            Home
          </a>
        </li>
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        {github.project && (
          <li>
            <a href={github.project}>GitHub</a>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--t-small) var(--ease),
      background-color var(--t-small) var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.97rem;
    letter-spacing: -0.01em;
    flex: none;
  }
  .brand img {
    width: 28px;
    height: 28px;
  }
  .primary {
    margin: 0 auto;
  }
  .links {
    display: flex;
    gap: clamp(4px, 1.4vw, 22px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 6px 4px;
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
    transition: color var(--t-feedback) var(--ease);
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--text);
  }
  .links a[aria-current='page'] {
    box-shadow: inset 0 -1px 0 var(--text);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .tool-link {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
    padding: 6px 6px;
  }
  .tool-link:hover {
    color: var(--text);
  }
  .btn-compact {
    min-height: 32px;
    padding: 0 12px;
    font-size: 0.8125rem;
    border-radius: 7px;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--text);
  }
  .theme-sun,
  .theme-moon,
  .close-icon {
    display: none;
    line-height: 0;
  }
  [data-effective='light'] .theme-sun,
  [data-effective='dark'] .theme-moon,
  .menu-toggle .open-icon {
    display: inline;
    line-height: 0;
  }
  .menu-toggle[aria-expanded='true'] .open-icon {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .close-icon {
    display: inline;
  }
  .menu-toggle {
    display: none;
  }
  .sheet {
    border-top: 1px solid var(--line);
    background: var(--bg);
    max-height: calc(100dvh - var(--header-h) - env(safe-area-inset-top));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 8px var(--gutter) calc(20px + env(safe-area-inset-bottom));
  }
  .sheet a {
    display: block;
    padding: 14px 0;
    font-size: var(--step-1);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .sheet a[aria-current='page'] {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .primary,
    .tool-link {
      display: none;
    }
    .menu-toggle {
      display: inline-grid;
    }
    .tools {
      margin-left: auto;
    }
  }
  @media (max-width: 380px) {
    .btn-compact {
      display: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
