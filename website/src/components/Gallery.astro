---
// Screenshot gallery. Author: A097MPRUS.
// Only screenshots marked "available" in screenshots.json are shown. Each one is a Shot: aspect
// ratio kept, never wider than its natural size or taller than the column allows; all of a
// gallery open as one browsable set in the full-size viewer.
import Shot from './Shot.astro';
import { screenshots } from '../data/site';

interface Props {
  group?: string;
  files?: string[];
  columns?: 1 | 2;
  set?: string;
}
const { group, files, columns = 2, set } = Astro.props;
const items = screenshots.items
  .filter((s) => s.status === 'available')
  .filter((s) => (group ? s.group === group : true))
  .filter((s) => (files ? files.includes(s.file) : true));
const setName = set ?? `gallery-${group ?? 'files'}`;
---

{items.length > 0 && (
  <ul class:list={['gallery', `cols-${columns}`, { single: items.length === 1 }]}>
    {items.map((item) => (
      <li>
        <Shot
          file={item.file}
          set={setName}
          maxHeight={columns === 1 ? 'min(72svh, 760px)' : 'min(60svh, 560px)'}
          sizes={
            columns === 1 ? '(max-width: 1180px) 94vw, 1100px' : '(max-width: 860px) 94vw, 620px'
          }
          captionClass="gallery-caption"
        />
        <p class="edition mono">{item.edition}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }
  .cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .gallery.single {
    grid-template-columns: 1fr;
  }
  .gallery :global(.gallery-caption) {
    text-align: left;
    margin-left: 0;
  }
  .edition {
    margin: 4px 0 0;
    font-size: var(--step--2);
    color: var(--faint);
  }
</style>
