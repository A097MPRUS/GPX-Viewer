---
// Route, elevation profile and readouts of the synthetic sample, computed at build time.
// The same markup serves the homepage introduction (played once, then scrubbable) and the
// scroll-linked explanation. Author: A097MPRUS.
import { sampleGeometry } from '../lib/sample';

interface Props {
  id: string;
  /** "intro": draws once on load. "story": driven by scroll progress. */
  mode: 'intro' | 'story';
  label: string;
}
const { id, mode, label } = Astro.props;
const g = sampleGeometry();
const first = g.columns[0]!;
const P = g.profile;
---

<div class="stage-wrap">
  <div
    class:list={['stage', `stage-${mode}`]}
    data-stage={mode}
    data-columns={JSON.stringify(g.columns)}
    data-total={Math.round(g.stats.distance)}
  >
    <div class="map-area">
      <svg class="map" viewBox={`0 0 ${g.width} ${g.height}`} role="img" aria-label={label}>
        <defs>
          <pattern id={`${id}-grid`} width="50" height="50" patternUnits="userSpaceOnUse">
            <path d="M50 0H0V50" fill="none" stroke="var(--grid)" stroke-width="1"></path>
          </pattern>
        </defs>
        <rect width={g.width} height={g.height} fill={`url(#${id}-grid)`}></rect>
        <path class="route-under" d={g.route}></path>
        <path class="route" d={g.route} pathLength="1" data-route></path>
        <circle class="pin pin-start" cx={g.start[0]} cy={g.start[1]} r="6"></circle>
        <g class="marker" data-marker transform={`translate(${first[0]} ${first[1]})`}>
          <circle r="13" class="marker-halo"></circle>
          <circle r="6" class="marker-dot"></circle>
        </g>
      </svg>
    </div>
    <dl class="readout" aria-live="off">
      <div>
        <dt>Distance</dt>
        <dd>
          <span data-out="dist">0.0</span>
          <small> km</small>
        </dd>
      </div>
      <div>
        <dt>Elevation</dt>
        <dd>
          <span data-out="ele">{first[3]}</span>
          <small> m</small>
        </dd>
      </div>
      <div>
        <dt>Gradient</dt>
        <dd>
          <span data-out="grade">-</span>
          <small> %</small>
        </dd>
      </div>
      <div>
        <dt>Speed</dt>
        <dd>
          <span data-out="speed">-</span>
          <small> km/h</small>
        </dd>
      </div>
    </dl>
    <div
      class="profile"
      data-profile
      role="slider"
      tabindex="0"
      aria-label="Position along the sample route"
      aria-valuemin="0"
      aria-valuemax={Math.round(g.stats.distance)}
      aria-valuenow="0"
      aria-valuetext="0.0 km"
    >
      <svg viewBox={`0 0 ${P.width} ${P.height}`} preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id={`${id}-grade`} x1="0" x2="1" y1="0" y2="0">
            {g.stops.map((s) => (
              <stop offset={`${s.offset}%`} stop-color={s.color} />
            ))}
          </linearGradient>
          <clipPath id={`${id}-clip`}>
            <rect width={P.width} height={P.height} data-clip></rect>
          </clipPath>
        </defs>
        <g clip-path={`url(#${id}-clip)`}>
          <path d={P.area} fill={`url(#${id}-grade)`} class="area"></path>
          <path d={P.ridge} class="ridge" vector-effect="non-scaling-stroke"></path>
          <path d={P.speed} class="speed" data-speed vector-effect="non-scaling-stroke"></path>
        </g>
        <line
          class="cursor"
          data-cursor
          x1="0"
          x2="0"
          y1="0"
          y2={P.height}
          vector-effect="non-scaling-stroke"
        ></line>
      </svg>
      <span class="axis axis-high">{P.high} m</span>
      <span class="axis axis-low">{P.low} m</span>
      <span class="axis axis-speed" data-speed-axis>
        {P.speedMax} km/h
      </span>
    </div>
  </div>
</div>

<style>
  .stage-wrap {
    container-type: inline-size;
  }
  .stage {
    --map-bg: var(--bg-raised);
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(150px, 16vw, 210px);
    grid-template-areas:
      'map readout'
      'profile profile';
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .map-area {
    grid-area: map;
    background: var(--map-bg);
    min-width: 0;
  }
  .map {
    display: block;
    width: 100%;
    height: 100%;
    max-height: min(52svh, 520px);
  }
  .route-under {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .route {
    fill: none;
    stroke: var(--route);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }
  .pin-start {
    fill: var(--surface);
    stroke: var(--ok);
    stroke-width: 3;
  }
  .marker-halo {
    fill: color-mix(in srgb, var(--marker) 20%, transparent);
  }
  .marker-dot {
    fill: var(--marker);
    stroke: var(--surface);
    stroke-width: 2.5;
  }
  .readout {
    grid-area: readout;
    margin: 0;
    display: grid;
    align-content: center;
    gap: 18px;
    padding: 20px 22px;
    border-left: 1px solid var(--line);
  }
  .readout dt {
    font-size: var(--step--2);
    color: var(--muted);
  }
  .readout dd {
    margin: 0;
    font: 500 clamp(1.25rem, 1rem + 1vw, 1.75rem) / 1.15 var(--font-sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .readout small {
    font-size: 0.55em;
    font-weight: 400;
    color: var(--muted);
  }
  .profile {
    grid-area: profile;
    position: relative;
    height: clamp(96px, 14svh, 150px);
    border-top: 1px solid var(--line);
    cursor: ew-resize;
    touch-action: pan-y;
    outline: none;
  }
  .profile:focus-visible {
    box-shadow: inset 0 0 0 2px var(--focus);
  }
  .profile svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .area {
    opacity: 0.9;
  }
  .ridge {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.5;
    stroke-width: 1.25;
  }
  .speed {
    fill: none;
    stroke: var(--route);
    stroke-width: 1.75;
    opacity: 0;
    transition: opacity var(--t-content) var(--ease);
  }
  .cursor {
    stroke: var(--marker);
    stroke-width: 1.5;
  }
  .axis {
    position: absolute;
    left: 8px;
    font: 400 10.5px/1 var(--font-mono);
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    padding: 2px 4px;
    border-radius: 3px;
    pointer-events: none;
  }
  .axis-high {
    top: 8px;
  }
  .axis-low {
    bottom: 6px;
  }
  .axis-speed {
    top: 8px;
    left: auto;
    right: 8px;
    color: var(--route);
    opacity: 0;
    transition: opacity var(--t-content) var(--ease);
  }
  .stage.show-speed .speed,
  .stage.show-speed .axis-speed {
    opacity: 1;
  }
  /* In the scroll story on small screens the stage is in the page flow above the text, with a
     bounded height so the explanations follow soon after it. */
  @media (max-width: 960px), (max-height: 620px) {
    .stage-story .map {
      max-height: 42svh;
    }
    .stage-story .profile {
      height: 84px;
    }
  }
  @container (max-width: 620px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'map' 'readout' 'profile';
    }
    .readout {
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
      padding: 10px 12px;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .readout dd {
      font-size: 1.05rem;
    }
  }
</style>
