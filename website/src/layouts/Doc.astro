---
// Documentation article layout: section navigation, article, outline. Author: A097MPRUS.
import Base from './Base.astro';
import type { MarkdownHeading } from 'astro';
import { SECTIONS, allDocs } from '../lib/docs';
import { manifest, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  slug: string;
  updated: string;
  release?: string | undefined;
  headings: MarkdownHeading[];
}
const { title, description, slug, updated, release, headings } = Astro.props;
const releaseState = release
  ? manifest.releases.find((r) => r.family === 'macos' && r.version === release)?.status
  : undefined;
const docs = await allDocs();
const index = docs.findIndex((d) => d.id === slug);
const prev = index > 0 ? docs[index - 1] : undefined;
const next = index >= 0 && index < docs.length - 1 ? docs[index + 1] : undefined;
const outline = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} current="docs/">
  <div class="wrap wrap-wide doc-layout">
    <nav class="doc-nav" aria-label="Documentation">
      <details class="doc-nav-toggle" open>
        <summary>Documentation</summary>
        {SECTIONS.map((s) => (
          <div class="nav-group">
            <p class="nav-section">{s}</p>
            <ul>
              {docs
                .filter((d) => d.data.section === s)
                .map((d) => (
                  <li>
                    <a
                      href={url(`docs/${d.id}/`)}
                      aria-current={d.id === slug ? 'page' : undefined}
                    >
                      {d.data.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))}
      </details>
    </nav>
    <article class="article doc-article">
      <p class="crumb small">
        <a href={url('docs/')}>Documentation</a>
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {release && (
        <p class:list={['release-note small', { pending: releaseState === 'upcoming' }]}>
          {releaseState === 'upcoming'
            ? `Describes GPX Viewer ${release} for macOS, which is being prepared and not published yet.`
            : `Available from GPX Viewer ${release} for macOS.`}
        </p>
      )}
      <slot />
      <p class="updated small muted">Updated {updated}</p>
      <nav class="pager" aria-label="Previous and next article">
        {prev ? (
          <a href={url(`docs/${prev.id}/`)} rel="prev">
            <span class="small muted">Previous</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={url(`docs/${next.id}/`)} rel="next" class="next">
            <span class="small muted">Next</span>
            {next.data.title}
          </a>
        ) : (
          <span />
        )}
      </nav>
    </article>
    {outline.length > 1 && (
      <aside class="doc-outline" aria-label="On this page">
        <p class="nav-section">On this page</p>
        <ul>
          {outline.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>

<style>
  .release-note {
    margin: -8px 0 28px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .release-note.pending {
    color: var(--warn);
  }
  .doc-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr) 200px;
    gap: clamp(24px, 3vw, 56px);
    padding-top: 40px;
    padding-bottom: 80px;
    align-items: start;
  }
  .doc-nav,
  .doc-outline {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    max-height: calc(100dvh - var(--header-h) - 48px);
    overflow-y: auto;
    font-size: var(--step--1);
  }
  .doc-nav-toggle summary {
    display: none;
  }
  .nav-section {
    font-size: var(--step--2);
    color: var(--faint);
    margin: 18px 0 6px;
    font-weight: 600;
  }
  .nav-group:first-of-type .nav-section {
    margin-top: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .doc-nav a,
  .doc-outline a {
    display: block;
    padding: 5px 0;
    color: var(--muted);
    text-decoration: none;
  }
  .doc-nav a:hover,
  .doc-outline a:hover {
    color: var(--text);
  }
  .doc-nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
  .crumb a {
    color: var(--muted);
  }
  .doc-article .lede {
    margin-bottom: 2em;
  }
  .updated {
    margin-top: 3em;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .pager a {
    display: grid;
    gap: 2px;
    text-decoration: none;
  }
  .pager .next {
    text-align: right;
  }
  @media (max-width: 1180px) {
    .doc-layout {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .doc-outline {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .doc-layout {
      grid-template-columns: 1fr;
      padding-top: 16px;
    }
    .doc-nav {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--line);
      padding-bottom: 8px;
    }
    .doc-nav-toggle summary {
      display: block;
      cursor: pointer;
      font-weight: 600;
      padding: 10px 0;
      min-height: 44px;
    }
    .doc-nav a {
      padding: 10px 0;
    }
  }
</style>

<script>
  // On small screens the article list starts closed.
  const toggle = document.querySelector<HTMLDetailsElement>('.doc-nav-toggle');
  if (toggle && matchMedia('(max-width: 820px)').matches) toggle.open = false;
</script>
