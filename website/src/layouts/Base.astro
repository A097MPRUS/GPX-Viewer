---
// Page shell. Author: A097MPRUS.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Section of the navigation to mark as current. */
  current?: string;
  /** Full-width pages (the viewer) skip the footer spacing. */
  app?: boolean;
}
const { title, description, current, app = false } = Astro.props;
const fullTitle = title === 'GPX Viewer' ? title : `${title} | GPX Viewer`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Until the owner approves the public launch, every build is a private preview and asks search
// engines not to index it (the preview host also requires sign-in).
const preview = import.meta.env.PUBLIC_SITE_STAGE !== 'public';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1015" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(url('og-image.png'), Astro.site).href} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="48x48" href={url('favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('icon-192.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <script is:inline>
      // Applies the saved appearance before the first paint. Browser storage may be unavailable.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var theme = localStorage.getItem('gpxv-theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={app ? 'is-app' : undefined}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!app && <Footer />}
    <script>
      import { initCounters, initEnter, initHeader, initMenu, initThemeToggle } from '../lib/site';
      import { bindShots } from '../lib/lightbox';
      bindShots();
      initThemeToggle();
      initMenu();
      initHeader();
      initEnter();
      initCounters();
    </script>
  </body>
</html>
