<script>
  import { playIntro } from '../lib/stage';
  const demo = document.querySelector<HTMLElement>('#graphs [data-stage]');
  if (demo) playIntro(demo);

  // Category tabs for the comparison: progressive enhancement; without JavaScript every table
  // is shown one after another.
  const tablist = document.querySelector<HTMLElement>('[data-tabs]');
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  if (tablist && panels.length) {
    tablist.hidden = false;
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      const all = tab.id === 'tab-all';
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        const show = all || `tab-${p.dataset['panel']}` === tab.id;
        p.hidden = !show;
        p.classList.toggle('is-shown', show);
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const next =
          e.key === 'ArrowRight'
            ? tabs[(i + 1) % tabs.length]
            : e.key === 'ArrowLeft'
              ? tabs[(i - 1 + tabs.length) % tabs.length]
              : e.key === 'Home'
                ? tabs[0]
                : e.key === 'End'
                  ? tabs[tabs.length - 1]
                  : undefined;
        if (next) {
          e.preventDefault();
          select(next, true);
        }
      });
    });
    // A link to a footnote or a table row opens the panel that contains it.
    const reveal = () => {
      const target = location.hash && document.querySelector(location.hash);
      const panel =
        target instanceof HTMLElement ? target.closest<HTMLElement>('[data-panel]') : null;
      const tab = panel && tabs.find((t) => t.id === `tab-${panel.dataset['panel']}`);
      if (tab) select(tab);
    };
    select(tabs[0]!);
    reveal();
    window.addEventListener('hashchange', reveal);
  }
</script>
