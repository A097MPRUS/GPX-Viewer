{
  "name": "gpx-viewer-site",
  "version": "1.0.0",
  "private": true,
  "description": "GPX Viewer website and GPX Viewer Web Lite",
  "author": "A097MPRUS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/stage-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:dist": "node scripts/check-dist.mjs",
    "verify": "npm run validate:data && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run validate:dist",
    "build:preview": "npm run validate:data && npm run build && node scripts/check-dist.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
